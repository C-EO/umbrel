# Build native install scripts serially instead of in parallel.
#
# umbreld has several native modules (node-pty, cpu-features, drivelist,
# ssh2) that compile via `node-gyp rebuild` during `npm clean-install`.
# By default npm runs these build scripts concurrently, and they all share
# the same node-gyp header cache (~/.cache/node-gyp/<version>). On a fresh
# CI runner the cache is empty, so the parallel builds race to download and
# extract the headers: one process creates the directory while another reads
# it mid-write and fails with "common.gypi not found", randomly breaking the
# install. Running build scripts in the foreground serialises them, so the
# headers are fully populated by the first build before the rest start.
foreground-scripts=true
