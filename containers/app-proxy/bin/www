#!/usr/bin/env node

const cookieParser = require('cookie-parser');
const express = require('express');
const waitPort = require('wait-port');

const proxy = require('../utils/proxy.js');
const authUtils = require('../utils/auth.js');
const umbrelRoutes = require('../routes/umbrel.js');
const handleErrorMiddleware = require('../middleware/handle_error.js');

const CONSTANTS = require('../utils/const.js');

const app = express();

function isTrustedForwardedRequest(req) {
	const address = (req.socket.remoteAddress || '').replace(/^::ffff:/, '');
	return address === '127.0.0.1' || address === '::1' || address === CONSTANTS.UMBREL_GATEWAY_IP;
}

app.disable('x-powered-by');
// LAN ingress is the browser-facing entry point. In Docker, the proxied request
// can arrive from the host gateway rather than loopback, so trust only those paths.
app.set('trust proxy', CONSTANTS.TRUSTED_PROXY_IPS);
app.set('view engine', 'ejs');

app.use(cookieParser(CONSTANTS.UMBREL_AUTH_SECRET));
app.use('/umbrel_', umbrelRoutes);

app.use(handleErrorMiddleware);

const middleware = proxy.apply(app);

// We'll only open the app proxy's port
// Once the app's port is open
console.log(`Waiting for ${CONSTANTS.APP_HOST}:${CONSTANTS.APP_PORT} to open...`);

const delay = ms => new Promise(resolve => setTimeout(resolve, ms));

(async () => {
	while(true) {
		try {
			await waitPort({
				host: CONSTANTS.APP_HOST,
				port: CONSTANTS.APP_PORT,
				output: "silent",
				// Wait indefinitely for the app to start
				timeout: 0
			});
			// Exit loop on success
			break;
		} catch (error) {
			console.log(`Error waiting for port: "${error.message}"`);
			// Wait before retrying
			await delay(100);
			console.log('Retrying...');
		}
	}

	console.log(`${CONSTANTS.APP.name} is now ready...`);

	const server = app.listen(CONSTANTS.PROXY_PORT, () => {
		console.log(`Listening on port: ${CONSTANTS.PROXY_PORT}`);
	});

	// WebSocket upgrade requests bypass the Express middleware chain, so we
	// must re-apply the same auth check here before handing off to the proxy.
	server.on('upgrade', async (req, socket, head) => {
		try {
			const pathname = (req.url || '/').split('?')[0] || '/';
			const authorized = await authUtils.isAuthorized({
				cookieHeader: req.headers.cookie,
				pathname,
				secure: isTrustedForwardedRequest(req) && req.headers['x-forwarded-proto'] === 'https',
			});
			if (!authorized) {
				socket.write('HTTP/1.1 401 Unauthorized\r\nConnection: close\r\n\r\n');
				socket.destroy();
				return;
			}
			middleware.upgrade(req, socket, head);
		} catch {
			socket.write('HTTP/1.1 401 Unauthorized\r\nConnection: close\r\n\r\n');
			socket.destroy();
		}
	});
})();
